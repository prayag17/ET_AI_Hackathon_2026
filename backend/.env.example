# Copy this file to `.env` (same folder) and fill in your key to enable
# real AI-generated GRAP advisories from OpenRouter.
#
# Get a free key at: https://openrouter.ai/keys
#
# Without this set, /maps/getAdvisory still works — it falls back to a
# deterministic, rule-based GRAP recommendation instead of an LLM-generated
# one. The city-wide baseline status card always works either way.
OPENROUTER_API_KEY=
